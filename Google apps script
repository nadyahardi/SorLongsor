// ── KONFIGURASI ────────────────────────────────────────────
const SHEET_NAME   = "SensorLog";    // Nama tab sheet
const EMAIL_ALERT  = "email@kamu.com";  // Email penerima alert
const ALERT_LEVELS = ["SIAGA", "AWAS"]; // Level yang trigger email

// ─────────────────────────────────────────────────────────
// Handler POST dari Gateway ESP32
// ─────────────────────────────────────────────────────────
function doPost(e) {
  try {
    // Parse JSON body
    const data = JSON.parse(e.postData.contents);

    // Validasi field wajib
    if (!data.timestamp || !data.node_id) {
      return jsonResponse({ status: "error", message: "Field kurang" });
    }

    // Simpan ke sheet
    appendToSheet(data);

    // Kirim email alert jika level tinggi
    if (ALERT_LEVELS.includes(data.alert)) {
      sendEmailAlert(data);
    }

    return jsonResponse({ status: "ok", message: "Data tersimpan" });

  } catch (err) {
    console.error("Error doPost:", err);
    return jsonResponse({ status: "error", message: err.toString() });
  }
}

// ─────────────────────────────────────────────────────────
// Handler GET (untuk testing dari browser)
// ─────────────────────────────────────────────────────────
/**
 * Tambahkan fungsi doGet yang sudah diupdate ini ke google_apps_script.js kamu
 * Ganti fungsi doGet yang lama dengan yang ini
 */

function doGet(e) {
  const action = e.parameter.action;

  if (action === 'getLogs') {
    const limit = parseInt(e.parameter.limit) || 20;
    return getLogsJSON(limit);
  }

  return jsonResponse({ status: 'ok', message: 'EWS Longsor API aktif' });
}

function getLogsJSON(limit) {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SHEET_NAME);

  if (!sheet) {
    return jsonResponseWithCORS({ data: [], message: 'Sheet belum ada data' });
  }

  const allData = sheet.getDataRange().getValues();
  if (allData.length <= 1) {
    return jsonResponseWithCORS({ data: [] });
  }

  const headers = allData[0];
  const rows    = allData.slice(1);

  // Ambil N baris terakhir
  const recentRows = rows.slice(-limit);

  const result = recentRows.map(row => ({
    timestamp : row[0] ? Utilities.formatDate(new Date(row[0]), 'Asia/Jakarta', 'yyyy-MM-dd HH:mm:ss') : '',
    node_id   : row[1],
    sm20      : parseFloat(row[2]) || 0,
    sm40      : parseFloat(row[3]) || 0,
    sm60      : parseFloat(row[4]) || 0,
    sm_surf   : parseFloat(row[5]) || 0,
    delta_sm  : parseFloat(row[6]) || 0,
    alert     : row[7] || 'AMAN',
    rssi      : parseInt(row[8])  || 0,
    snr       : parseFloat(row[9]) || 0
  }));

  return jsonResponseWithCORS({ data: result });
}

// CORS-aware response (agar bisa diakses dari web dashboard)
function jsonResponseWithCORS(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

// ─────────────────────────────────────────────────────────
// Simpan data ke Google Sheets
// ─────────────────────────────────────────────────────────
function appendToSheet(data) {
  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  let   sheet = ss.getSheetByName(SHEET_NAME);

  // Buat sheet baru jika belum ada
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
    // Tambahkan header
    sheet.appendRow([
      "Timestamp", "Node ID",
      "SM 20cm (%)", "SM 40cm (%)", "SM 60cm (%)", "SM Surface (%)",
      "Delta SM (%)", "Alert Level",
      "RSSI (dBm)", "SNR (dB)"
    ]);

    // Format header
    const headerRange = sheet.getRange(1, 1, 1, 10);
    headerRange.setBackground("#1a1a2e");
    headerRange.setFontColor("#ffffff");
    headerRange.setFontWeight("bold");
    sheet.setFrozenRows(1);
  }

  // Tentukan warna baris berdasarkan alert level
  const rowData = [
    data.timestamp,
    data.node_id,
    data.sm20   || 0,
    data.sm40   || 0,
    data.sm60   || 0,
    data.sm_surf || 0,
    data.delta_sm || 0,
    data.alert  || "UNKNOWN",
    data.rssi   || 0,
    data.snr    || 0
  ];

  sheet.appendRow(rowData);

  // Warnai baris berdasarkan level
  const lastRow   = sheet.getLastRow();
  const rowRange  = sheet.getRange(lastRow, 1, 1, 10);
  const alertColors = {
    "AMAN"    : "#e8f5e9",  // hijau muda
    "WASPADA" : "#fff9c4",  // kuning muda
    "SIAGA"   : "#ffe0b2",  // oranye muda
    "AWAS"    : "#ffcdd2"   // merah muda
  };
  rowRange.setBackground(alertColors[data.alert] || "#ffffff");

  // Auto-resize kolom
  sheet.autoResizeColumns(1, 10);

  console.log(`Data disimpan: ${data.timestamp} | ${data.node_id} | ${data.alert}`);
}

// ─────────────────────────────────────────────────────────
