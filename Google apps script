    <div style="background:#c0392b;color:white;padding:20px;border-radius:8px 8px 0 0">
      <h2 style="margin:0">${emoji} PERINGATAN LONGSOR — ${data.alert}</h2>
    </div>
    <div style="background:#f9f9f9;padding:20px;border:1px solid #ddd;border-top:none;border-radius:0 0 8px 8px">
      <table style="width:100%;border-collapse:collapse">
        <tr><td style="padding:8px;color:#666">📍 Node</td>
            <td style="padding:8px;font-weight:bold">${data.node_id}</td></tr>
        <tr style="background:#fff"><td style="padding:8px;color:#666">🕐 Waktu</td>
            <td style="padding:8px">${data.timestamp}</td></tr>
        <tr><td style="padding:8px;color:#666">🌊 SM 20cm</td>
            <td style="padding:8px">${data.sm20}%</td></tr>
        <tr style="background:#fff"><td style="padding:8px;color:#666">🌊 SM 40cm</td>
            <td style="padding:8px">${data.sm40}%</td></tr>
        <tr><td style="padding:8px;color:#666">🌊 SM 60cm</td>
            <td style="padding:8px">${data.sm60}%</td></tr>
        <tr style="background:#fff"><td style="padding:8px;color:#666">📈 ΔSM</td>
            <td style="padding:8px">${data.delta_sm}%</td></tr>
        <tr><td style="padding:8px;color:#666">📡 RSSI</td>
            <td style="padding:8px">${data.rssi} dBm</td></tr>
      </table>
      ${data.alert === "AWAS" ? '<p style="color:red;font-weight:bold;font-size:18px">⚠️ SEGERA EVAKUASI WARGA!</p>' : ''}
